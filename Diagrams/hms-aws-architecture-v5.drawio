          <mxGeometry x="900" y="260" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_cw" value="CloudWatch Logs&#xa;(VPC Flow Logs)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1">
