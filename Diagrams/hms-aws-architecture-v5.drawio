        <mxCell id="r_guardduty" value="GuardDuty&#xa;(analyzes logs)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.guardduty;" vertex="1" parent="1">
          <mxGeometry x="1050" y="430" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_flow_note" value="&lt;b&gt;Logging &amp;amp; monitoring flow:&lt;/b&gt;  ALB and CloudFront write access logs directly to a dedicated, versioned S3 bucket (separate from the Terraform-state bucket) for audit and cost analysis. VPC Flow Logs stream to a CloudWatch Logs group for near-real-time visibility. GuardDuty continuously analyzes VPC Flow Logs, CloudTrail, and DNS logs for threat detection; findings surface in Security Hub (see main page)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#C6CDD6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontColor=#3B4552;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r_legend" value="&lt;b&gt;Key:&lt;/b&gt;  — solid = live request traffic &amp;nbsp;&amp;nbsp; - - dashed = attached security/cert or log delivery&lt;br/&gt;&lt;font color=&#39;#8C4FFF&#39;&gt;■&lt;/font&gt; Networking &amp;nbsp; &lt;font color=&#39;#DD344C&#39;&gt;■&lt;/font&gt; Security &amp;nbsp; &lt;font color=&#39;#7AA116&#39;&gt;■&lt;/font&gt; Storage &amp;nbsp; &lt;font color=&#39;#E7157B&#39;&gt;■&lt;/font&gt; Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#C6CDD6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fontColor=#3B4552;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="① DNS lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;jettySize=auto;curved=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_users" target="r_route53">
