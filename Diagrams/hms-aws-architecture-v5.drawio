        <mxCell id="ghactions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2088FF;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=10;" value="GitHub Actions&#xa;CI/CD Pipeline" vertex="1">
