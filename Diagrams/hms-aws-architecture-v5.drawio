        </mxCell>
        <mxCell id="terraform" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5C4EE5;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=10;" value="Terraform&#xa;(Infrastructure as Code)" vertex="1">
          <mxGeometry height="50" width="170" x="880" y="1532" as="geometry" />
