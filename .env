# MediCore HMS — Local docker-compose overrides
# Copy of .env.example values plus a local-only datasource override.
# Docker Compose auto-loads this file.

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_DATABASE=medicore_hms
MYSQL_ROOT_PASSWORD=root_pass

# ─── Application DB user (shared across all microservices) ────────────────────
SPRING_DATASOURCE_USERNAME=medicore
SPRING_DATASOURCE_PASSWORD=medicore_pass

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ─── Datasource (LOCAL ONLY) ──────────────────────────────────────────────────
# The compose default enforces verifyServerCertificate=true, which is correct for
# the production AWS RDS instance (CA-signed cert). The local containerized
# mysql:8.0 uses an auto-generated self-signed certificate that the JVM truststore
# does not trust, which makes every service fail at startup with:
#   CertPathValidatorException: Path does not chain with any of the trust anchors
# For local dev we keep TLS enabled but skip server-certificate verification.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/medicore_hms?useSSL=true&verifyServerCertificate=false&serverTimezone=UTC
