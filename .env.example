# MediCore HMS — Sandbox Environment Variables
#
# Copy this file to .env and fill in your values.
# Docker Compose will automatically load .env from the same directory.
# setup-sandbox.sh will also read these variables and skip interactive prompts
# if they are already exported in the shell.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your passwords
#   source .env && ./setup-sandbox.sh

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_DATABASE=medicore_hms
MYSQL_ROOT_PASSWORD=root_pass

# ─── Application DB user (shared across all microservices) ────────────────────
SPRING_DATASOURCE_USERNAME=medicore
SPRING_DATASOURCE_PASSWORD=medicore_pass

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ─── OpenTelemetry (optional overrides) ──────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp

# ─── Spring JPA (optional override) ──────────────────────────────────────────
# SPRING_JPA_HIBERNATE_DDL_AUTO=update
